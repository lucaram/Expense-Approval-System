{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": [
      "node",
      "jest",
      "@testing-library/jest-dom"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "playwright.config.ts",
    "jest.config.ts",
    "jest.setup.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "frontend/**/*.ts",
    "frontend/**/*.tsx",
    "backend/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "frontend/node_modules",
    "backend/node_modules"
  ]
}